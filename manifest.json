{
  "manifest_version": 3,
  "name": "WhatsappReextended",
  "version": "1.3.4",
  "description": "WhatsappReextended - Studio & Sticker Manager WhatsApp Web dengan fitur Crop, Custom Pack, dan pengiriman stiker asli.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WhatsappReextended"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wppconnect-wa.js", "page_bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "stickers/*",
        "icons/*",
        "wppconnect-wa.js",
        "page_bridge.js"
      ],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
